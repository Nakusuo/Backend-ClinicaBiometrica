# development | production
# En production la API no arranca si SECRET_KEY es insegura o si SEED_DEMO_DATA está activo.
ENVIRONMENT=development

# Para correr localmente con tu PostgreSQL local:
# DATABASE_URL=postgresql://postgres:TU_CLAVE@localhost:5432/telemedicina
# Para correr con Docker (el host es 'db' porque coincide con el nombre del servicio en docker-compose):
DATABASE_URL=postgresql://postgres:TU_CLAVE@db:5432/telemedicina
POSTGRES_USER=postgres
POSTGRES_PASSWORD=TU_CLAVE
POSTGRES_DB=telemedicina

# Mínimo 32 caracteres. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Dominio(s) del frontend separados por coma.
# Ejemplo: CORS_ORIGINS=https://clinica.tudominio.com,http://TU_IP_PUBLICA
CORS_ORIGINS=http://localhost:4200

# Crea un médico y una paciente de prueba (contraseña: password123) si la base está vacía.
# Solo para desarrollo.
SEED_DEMO_DATA=true

# Los médicos que se registran solos quedan inactivos hasta que otro médico
# los apruebe con POST /api/doctores/{id}/activar
DOCTOR_REQUIRES_APPROVAL=true

# Docker publica la API solo en 127.0.0.1 (Nginx la expone). Usa 0.0.0.0 para probar sin Nginx.
API_BIND_ADDRESS=127.0.0.1

# Token para los webhooks (FreePBX/Asterisk y agenda externa). Sin él, los webhooks responden 503.
# Debe enviarse en el header: X-Webhook-Token
ASTERISK_WEBHOOK_TOKEN=

# MariaDB interna de FreePBX. Usar un usuario SOLO LECTURA.
FREEPBX_DB_HOST=ip_o_hostname_freepbx
FREEPBX_DB_PORT=3306
FREEPBX_DB_USER=telemedicina_ro
FREEPBX_DB_PASSWORD=cambia-esta-clave
FREEPBX_DB_NAME=asteriskcdrdb
